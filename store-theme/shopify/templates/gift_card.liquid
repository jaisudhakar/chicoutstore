{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'gift_card.title' | t }} — {{ shop.name }}</title>
    {{ 'store.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main class="page-width not-found">
      <p class="header__logo" style="display:inline-block">{{ shop.name }}</p>
      <h1 class="h1" style="margin:24px 0 8px">{{ 'gift_card.title' | t }}</h1>
      <p class="h0">{{ gift_card.balance | money }}</p>
      {%- if gift_card.expired -%}<p class="form-message form-message--error">{{ 'gift_card.expired' | t }}</p>{%- endif -%}
      <p class="muted">{{ 'gift_card.code' | t }}</p>
      <p class="h2">{{ gift_card.code | format_code }}</p>
      <p><a class="button" href="{{ shop.url }}">{{ 'cart.continue' | t }}</a></p>
    </main>
  </body>
</html>
