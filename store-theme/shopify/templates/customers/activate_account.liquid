<div class="page-width page-content" style="max-width:480px">
  <h1 class="h1" style="margin-bottom:20px">{{ 'customer.activate' | t }}</h1>
  {%- form 'activate_customer_password', class: 'contact-form' -%}
    {%- if form.errors -%}<div class="form-message form-message--error full">{{ form.errors | default_errors }}</div>{%- endif -%}
    <label class="field full">{{ 'customer.password' | t }}<input type="password" name="customer[password]" autocomplete="new-password"></label>
    <label class="field full">{{ 'customer.confirm_password' | t }}<input type="password" name="customer[password_confirmation]" autocomplete="new-password"></label>
    <div class="full"><button class="button" type="submit">{{ 'customer.activate' | t }}</button></div>
  {%- endform -%}
</div>
