<div class="page-width page-content">
  <h1 class="h1">{{ 'customer.my_account' | t }}</h1>
  <p><a class="link" href="{{ routes.account_logout_url }}">{{ 'customer.log_out' | t }}</a></p>
  <h2 class="h2" style="margin:32px 0 12px">{{ 'customer.order_history' | t }}</h2>
  {%- paginate customer.orders by 20 -%}
    {%- if customer.orders.size > 0 -%}
      <table class="cart-page__table">
        <thead><tr><th>{{ 'customer.order' | t }}</th><th>{{ 'customer.date' | t }}</th><th>{{ 'customer.payment_status' | t }}</th><th>{{ 'customer.fulfillment_status' | t }}</th><th>{{ 'customer.total' | t }}</th></tr></thead>
        <tbody>
          {%- for order in customer.orders -%}
            <tr><td><a class="link" href="{{ order.customer_url }}">{{ order.name }}</a></td><td>{{ order.created_at | time_tag: format: 'date' }}</td><td>{{ order.financial_status_label }}</td><td>{{ order.fulfillment_status_label }}</td><td>{{ order.total_net_amount | money_with_currency }}</td></tr>
          {%- endfor -%}
        </tbody>
      </table>
    {%- else -%}
      <p>{{ 'customer.no_orders' | t }}</p>
    {%- endif -%}
  {%- endpaginate -%}
  <h2 class="h2" style="margin:32px 0 12px">{{ 'customer.account_details' | t }}</h2>
  {{ customer.default_address | format_address }}
  <p><a class="link" href="{{ routes.account_addresses_url }}">{{ 'customer.addresses' | t }} ({{ customer.addresses_count }})</a></p>
</div>
