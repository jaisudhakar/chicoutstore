<section class="image-with-text{% if section.settings.reverse %} image-with-text--reverse{% endif %}">
  <div class="image-with-text__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 750px) 50vw, 100vw' }}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag }}
    {%- endif -%}
  </div>
  <div class="image-with-text__content">
    {%- if section.settings.caption != blank -%}<p class="caption">{{ section.settings.caption | escape }}</p>{%- endif -%}
    <h2 class="h1">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="button button--secondary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "reverse", "label": "Image on the right", "default": false },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Statement shirts" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Embroidered & printed" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Florals, vines and yoke embroidery on easy fits — one shirt is all the outfit needs.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [ { "name": "Image with text" } ]
}
{% endschema %}
