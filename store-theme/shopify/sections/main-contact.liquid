<div class="page-width">
  <div class="collection-hero">
    <ol class="breadcrumbs"><li><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li><li>{{ page.title | escape }}</li></ol>
    <h1 class="h1">{{ page.title | escape }}</h1>
  </div>
  <div class="contact" style="padding-top:0">
    {%- form 'contact', class: 'contact-form', id: 'ContactForm' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success full" role="status">{{ 'contact.success' | t }}</p>
      {%- elsif form.errors -%}
        <div class="form-message form-message--error full" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <label class="field">{{ 'contact.name' | t }}<input type="text" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"></label>
      <label class="field">{{ 'contact.email' | t }} *<input type="email" name="contact[email]" autocomplete="email" required value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"></label>
      <label class="field full">{{ 'contact.phone' | t }}<input type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}"></label>
      <label class="field full">{{ 'contact.comment' | t }}<textarea name="contact[body]">{{ form.body }}</textarea></label>
      <div class="full"><button class="button" type="submit">{{ 'contact.send' | t }}</button></div>
    {%- endform -%}
    <div class="contact-details">
      <h2>{{ section.settings.heading | escape }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
      {%- if page.content != blank -%}<div class="rte">{{ page.content }}</div>{%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Questions about an order, sizing or returns? Send us a message and we’ll get back to you.</p>" }
  ]
}
{% endschema %}
