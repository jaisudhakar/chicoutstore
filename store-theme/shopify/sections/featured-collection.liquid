{%- assign c = section.settings.collection -%}
<section class="section"{% if section.settings.no_top %} style="padding-top:0"{% endif %}>
  <div class="page-width">
    <div class="title-row">
      <h2 class="h2">{{ section.settings.heading | escape }}</h2>
      <a class="link" href="{{ c.url | default: routes.all_products_collection_url }}">{{ 'general.view_all' | t }}</a>
    </div>
    <ul class="product-grid">
      {%- if c != blank and c.products_count > 0 -%}
        {%- for product in c.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.limit) -%}
          <li class="card"><div class="card__media">{{ 'product-apparel-1' | placeholder_svg_tag }}</div><div class="card__info"><h3 class="card__title">Product title</h3></div></li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New arrivals" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "no_top", "label": "Remove top spacing", "default": false }
  ],
  "presets": [ { "name": "Featured collection" } ]
}
{% endschema %}
