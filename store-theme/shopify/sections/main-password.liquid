<div class="page-width not-found">
  <p class="header__logo" style="display:inline-block">{{ shop.name }}</p>
  <h1 class="h1" style="margin:24px 0 12px">{{ 'password.opening_soon' | t }}</h1>
  {%- if shop.password_message != blank -%}<p class="muted">{{ shop.password_message }}</p>{%- endif -%}
  <div style="max-width:420px;margin:28px auto 0">
    {%- form 'storefront_password', class: 'newsletter-form' -%}
      <label class="visually-hidden" for="Password">{{ 'customer.password' | t }}</label>
      <input type="password" name="password" id="Password" autocomplete="current-password" placeholder="{{ 'customer.password' | t }}">
      <button class="button" type="submit">{{ 'password.enter' | t }}</button>
      {%- if form.errors -%}<p class="form-message form-message--error" style="flex-basis:100%">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
