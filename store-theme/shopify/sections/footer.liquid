<footer class="site-footer">
  <div class="page-width">
    <div class="footer__grid">
      <div class="footer__brand">
        <a class="header__logo" href="{{ routes.root_url }}" style="color:#fff">{{ shop.name }}</a>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        <div class="footer__social">
          {%- if settings.social_instagram_link != blank -%}<a href="{{ settings.social_instagram_link }}" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>{%- endif -%}
          {%- if settings.social_facebook_link != blank -%}<a href="{{ settings.social_facebook_link }}" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>{%- endif -%}
          {%- if settings.social_youtube_link != blank -%}<a href="{{ settings.social_youtube_link }}" aria-label="YouTube">{% render 'icon', name: 'youtube' %}</a>{%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <h2>{{ block.settings.heading | escape }}</h2>
          <ul>
            {%- for link in block.settings.menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}

      <div class="footer__newsletter">
        <h2>{{ section.settings.newsletter_heading | escape }}</h2>
        {%- form 'customer', class: 'newsletter-form', id: 'FooterNewsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="FooterEmail">{{ 'newsletter.email' | t }}</label>
          <input id="FooterEmail" type="email" name="contact[email]" placeholder="{{ 'newsletter.email' | t }}" autocomplete="email" required>
          <button class="button" type="submit">{{ 'newsletter.subscribe' | t }}</button>
          {%- if form.posted_successfully? -%}<p class="form-message form-message--success" style="flex-basis:100%">{{ 'newsletter.success' | t }}</p>{%- endif -%}
          {%- if form.errors -%}<p class="form-message form-message--error" style="flex-basis:100%">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endform -%}
      </div>
    </div>

    <div class="footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}</span>
      <span>
        {%- for policy in shop.policies -%}
          {%- unless forloop.first %} · {% endunless -%}<a href="{{ policy.url }}">{{ policy.title }}</a>
        {%- endfor -%}
      </span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "max_blocks": 3,
  "settings": [
    { "type": "textarea", "id": "text", "label": "Brand text", "default": "Statement shirts, everyday solids, checks, trousers and denim for men." },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Subscribe" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ]
}
{% endschema %}
