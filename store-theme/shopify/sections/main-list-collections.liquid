<div class="page-width">
  <div class="collection-hero"><h1 class="h1">{{ section.settings.title | escape }}</h1></div>
  <div class="collection-list" style="padding-bottom:64px">
    {%- for c in collections -%}
      {%- if c.products_count > 0 -%}
        <a class="collection-card" href="{{ c.url }}">
          <div class="collection-card__media">
            {%- if c.featured_image -%}{{ c.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 750px) 25vw, 50vw' }}{%- else -%}{{ 'collection-apparel-1' | placeholder_svg_tag }}{%- endif -%}
          </div>
          <span class="collection-card__title">{{ c.title | escape }}</span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{ "name": "Collections list", "settings": [ { "type": "text", "id": "title", "label": "Title", "default": "Collections" } ] }
{% endschema %}
